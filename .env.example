# Nextus Realty — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Real environment variables (e.g. set by your host) override anything here.

# HTTP port the server listens on.
PORT=3000

# SQLite database file location.
DB_PATH=data/nextus.db

# Admin (CMS) login credentials. CHANGE THESE before deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Lead-form delivery (nothing is stored) ---
# Each submission is emailed over Gmail SMTP. On the sending Google account,
# turn on 2-Step Verification and create an App Password:
#   https://myaccount.google.com/apppasswords
# Then set the account address and that 16-character App Password (spaces ok).
GMAIL_USER=magdykishk314@gmail.com
GMAIL_APP_PASSWORD=
# Who receives the lead emails.
LEAD_TO_EMAIL=magdykishk314@gmail.com
