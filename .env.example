# Nextus Realty - environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Real environment variables (e.g. set by your host) override anything here.

# HTTP port the server listens on.
PORT=3000

# SQLite database file location.
DB_PATH=data/nextus.db

# Admin (CMS) login credentials. CHANGE THESE before deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Analytics + Search Console (optional) ---
# GA4 Measurement ID (G-XXXXXXXXXX) turns on Google Analytics site-wide.
GA_MEASUREMENT_ID=
# Google Search Console verification token (only if verifying via a meta tag
# rather than DNS). Leave blank when verifying by DNS.
GSC_VERIFICATION=

