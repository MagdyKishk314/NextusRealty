<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/#top">
      <span class="brand__mark">N</span>
      <span class="brand__name">Nextus<span class="accent"> Realty</span></span>
    </a>

    <nav class="nav" aria-label="Primary">
      <div class="nav__item">
        <a class="nav__top" href="/#top">Home</a>
      </div>
      <div class="nav__item nav__item--menu">
        <button type="button" class="nav__top nav__trigger" aria-haspopup="true" aria-expanded="false">
          Leads <span class="nav__caret" aria-hidden="true"></span>
        </button>
        <div class="nav__menu">
          <a href="/seller-leads">Seller Leads</a>
          <a href="/listing-leads">Listing Leads</a>
          <a href="/contractor-leads">Contractor Leads</a>
        </div>
      </div>
      <div class="nav__item">
        <a class="nav__top" href="/blog">Blog</a>
      </div>
      <div class="nav__item">
        <a class="nav__top" href="/faq">FAQ</a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--gold btn--sm" href="<%= bookHref %>">
        Book a call <%- include('icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
      </a>
      <button type="button" class="nav-burger" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span class="nav-burger__line"></span>
        <span class="nav-burger__line"></span>
        <span class="nav-burger__line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation panel (hidden >=860px; toggled by the burger) -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <nav class="mobile-menu__nav" aria-label="Mobile">
      <a class="mobile-menu__link" href="/#top">Home</a>
      <p class="mobile-menu__group">Leads</p>
      <a class="mobile-menu__link mobile-menu__link--sub" href="/seller-leads">Seller Leads</a>
      <a class="mobile-menu__link mobile-menu__link--sub" href="/listing-leads">Listing Leads</a>
      <a class="mobile-menu__link mobile-menu__link--sub" href="/contractor-leads">Contractor Leads</a>
      <a class="mobile-menu__link" href="/blog">Blog</a>
      <a class="mobile-menu__link" href="/faq">FAQ</a>
      <a class="btn btn--gold mobile-menu__cta" href="<%= bookHref %>">
        Book a call <%- include('icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
      </a>
    </nav>
  </div>
</header>
