<aside class="blog-sidebar">
  <div class="blog-sidebar__panel">
    <p class="blog-sidebar__label">Categories</p>
    <nav class="blog-sidebar__nav" aria-label="Blog categories">
      <a href="/blog"<%= !currentCategory ? ' class="is-active"' : '' %>>All articles</a>
      <% categories.forEach(function (c) { %>
        <a href="/blog?category=<%= encodeURIComponent(c) %>"<%= currentCategory === c ? ' class="is-active"' : '' %>><%= c %></a>
      <% }); %>
    </nav>
  </div>

  <div class="blog-sidebar__cta">
    <p class="blog-sidebar__cta-title">Exclusive, confirmed leads</p>
    <p class="blog-sidebar__cta-sub">One agent per lead, verified by a real person before it reaches you.</p>
    <a class="btn btn--gold btn--sm btn--block" href="/#get-leads">Get your leads</a>
  </div>
</aside>
