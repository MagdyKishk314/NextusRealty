<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="admin">
  <%- include('../partials/admin-bar') %>

  <main class="container container--narrow admin__main">
    <p><a class="link-gold" href="/admin">&larr; Dashboard</a></p>
    <h1><%= testimonial ? 'Edit testimonial' : 'New testimonial' %></h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form method="post" action="<%= formAction %>" class="admin-form">
      <label class="field"><span>Name *</span>
        <input type="text" name="name" required value="<%= testimonial ? testimonial.name : '' %>" />
      </label>
      <label class="field"><span>Role / company</span>
        <input type="text" name="role" placeholder="Broker, Coastal Group" value="<%= testimonial ? testimonial.role : '' %>" />
      </label>
      <label class="field"><span>Quote *</span>
        <textarea name="quote" rows="4" required><%= testimonial ? testimonial.quote : '' %></textarea>
      </label>
      <div class="field-row">
        <label class="field"><span>Rating (1–5)</span>
          <input type="number" name="rating" min="1" max="5" value="<%= testimonial ? testimonial.rating : 5 %>" />
        </label>
        <label class="field"><span>Sort order</span>
          <input type="number" name="sort_order" value="<%= testimonial ? testimonial.sort_order : 0 %>" />
        </label>
      </div>
      <label class="field"><span>Status</span>
        <select name="status">
          <option value="draft" <%= (!testimonial || testimonial.status === 'draft') ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= (testimonial && testimonial.status === 'published') ? 'selected' : '' %>>Published</option>
        </select>
      </label>

      <div class="admin-form__actions">
        <button type="submit" class="btn btn--gold">Save testimonial</button>
        <a class="link-gold" href="/admin">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
