<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="admin">
  <%- include('../partials/admin-bar') %>

  <main class="container container--narrow admin__main">
    <p><a class="link-gold" href="/admin">&larr; All posts</a></p>
    <h1><%= post ? 'Edit post' : 'New post' %></h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form method="post" action="<%= formAction %>" class="admin-form" enctype="multipart/form-data" data-post-form>
      <label class="field"><span>Title *</span>
        <input type="text" name="title" required placeholder="A clear, specific headline" value="<%= post ? post.title : '' %>" />
      </label>

      <div class="field-row">
        <label class="field"><span>Slug <span class="muted small">(auto from title)</span></span>
          <input type="text" name="slug" placeholder="my-post-slug" value="<%= post ? post.slug : '' %>" />
        </label>
        <label class="field"><span>Category <span class="muted small">(blog filter)</span></span>
          <input type="text" name="category" list="category-options" placeholder="e.g. Sourcing" value="<%= post ? (post.category || '') : '' %>" data-category />
          <datalist id="category-options">
            <% categories.forEach(function (c) { %><option value="<%= c %>"></option><% }); %>
          </datalist>
          <% if (categories.length) { %>
            <div class="chips">
              <% categories.forEach(function (c) { %><button type="button" class="chip" data-chip="<%= c %>"><%= c %></button><% }); %>
            </div>
          <% } %>
        </label>
      </div>

      <div class="field">
        <span>Cover image <span class="muted small">(JPG, PNG, WebP, GIF &mdash; up to 5&nbsp;MB)</span></span>
        <% if (post && post.image) { %>
          <div class="uploader__current">
            <img src="<%= post.image %>" alt="Current cover image" />
            <div>
              <p class="muted small" style="margin:0 0 6px">Current image</p>
              <label class="checkbox"><input type="checkbox" name="removeImage" value="1" /> Remove it</label>
            </div>
          </div>
        <% } %>
        <label class="uploader" data-uploader>
          <input type="file" name="image" accept="image/*" class="visually-hidden" data-file />
          <div class="uploader__hint" data-hint>
            <span class="uploader__icon"><%- include('../partials/icon', { name: 'plus', cls: 'icon' }) %></span>
            <span><strong>Click to choose an image</strong><br><span class="muted small">or drag &amp; drop it here</span></span>
          </div>
          <div class="uploader__preview" data-preview hidden>
            <img data-preview-img alt="Selected image preview" />
            <span class="small uploader__preview-name" data-preview-name></span>
            <span class="small uploader__replace">Click to replace</span>
          </div>
        </label>
        <button type="button" class="link-danger uploader__clear" data-clear hidden>Remove selected image</button>
      </div>

      <label class="field"><span>Excerpt <span class="muted small">(blog index &amp; meta description)</span></span>
        <textarea name="excerpt" rows="2" maxlength="220" data-excerpt><%= post ? post.excerpt : '' %></textarea>
        <span class="field-counter" data-excerpt-count aria-live="polite"></span>
      </label>

      <label class="field"><span>Body <span class="muted small">(plain text; blank lines start new paragraphs)</span></span>
        <textarea name="body" rows="14"><%= post ? post.body : '' %></textarea>
      </label>

      <div class="field"><span>Status</span>
        <label class="switch">
          <input type="checkbox" name="status" value="published" class="switch__input" <%= (post && post.status === 'published') ? 'checked' : '' %> />
          <span class="switch__track"><span class="switch__thumb"></span></span>
          <span class="switch__text">
            <span class="switch__on"><strong>Published</strong> <span class="muted small">live on the blog</span></span>
            <span class="switch__off"><strong>Draft</strong> <span class="muted small">hidden from the blog</span></span>
          </span>
        </label>
      </div>

      <div class="admin-form__bar">
        <button type="submit" class="btn btn--gold">Save post</button>
        <a class="link-gold" href="/admin">Cancel</a>
      </div>
    </form>
  </main>

  <script src="/js/bundle.js" defer></script>
</body>
</html>
