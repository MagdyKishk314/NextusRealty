<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="admin">
  <%- include('../partials/admin-bar') %>

  <main class="container container--narrow admin__main">
    <p><a class="link-gold" href="/admin/posts">&larr; All posts</a></p>
    <h1><%= post ? 'Edit post' : 'New post' %></h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form method="post" action="<%= formAction %>" class="admin-form" enctype="multipart/form-data">
      <label class="field"><span>Title *</span>
        <input type="text" name="title" required value="<%= post ? post.title : '' %>" />
      </label>
      <label class="field"><span>Slug <span class="muted small">(optional, auto-generated from title)</span></span>
        <input type="text" name="slug" placeholder="my-post-slug" value="<%= post ? post.slug : '' %>" />
      </label>
      <label class="field"><span>Category <span class="muted small">(shown as a filter on the blog)</span></span>
        <input type="text" name="category" list="category-options" placeholder="e.g. Sourcing" value="<%= post ? (post.category || '') : '' %>" />
        <datalist id="category-options">
          <% categories.forEach(function (c) { %><option value="<%= c %>"></option><% }); %>
        </datalist>
      </label>
      <div class="field"><span>Cover image <span class="muted small">(JPG, PNG, WebP, GIF &mdash; up to 5&nbsp;MB)</span></span>
        <% if (post && post.image) { %>
          <div class="image-preview">
            <img src="<%= post.image %>" alt="Current cover image" />
            <label class="image-preview__remove">
              <input type="checkbox" name="removeImage" value="1" /> Remove image
            </label>
          </div>
        <% } %>
        <input type="file" name="image" accept="image/*" />
        <% if (post && post.image) { %><p class="muted small">Uploading a new file replaces the current image.</p><% } %>
      </div>
      <label class="field"><span>Excerpt <span class="muted small">(shown on the blog index &amp; meta description)</span></span>
        <textarea name="excerpt" rows="2"><%= post ? post.excerpt : '' %></textarea>
      </label>
      <label class="field"><span>Body <span class="muted small">(plain text; blank lines start new paragraphs)</span></span>
        <textarea name="body" rows="14"><%= post ? post.body : '' %></textarea>
      </label>
      <label class="field"><span>Status</span>
        <select name="status">
          <option value="draft" <%= (!post || post.status === 'draft') ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= (post && post.status === 'published') ? 'selected' : '' %>>Published</option>
        </select>
      </label>

      <div class="admin-form__actions">
        <button type="submit" class="btn btn--gold">Save post</button>
        <a class="link-gold" href="/admin/posts">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
