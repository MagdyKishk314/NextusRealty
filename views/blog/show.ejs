<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main" class="page">
    <section class="section">
      <div class="container">
        <div class="blog-layout">
          <%- include('../partials/blog-sidebar', { categories: categories, currentCategory: currentCategory }) %>

          <article class="blog-main blog-article">
            <a class="link-gold post__back" href="/blog">← All posts</a>
            <div class="post__meta">
              <% if (post.category) { %><a class="post__cat" href="/blog?category=<%= encodeURIComponent(post.category) %>"><%= post.category %></a><% } %>
              <time class="post__date"><%= formatDate(post.published_at) %></time>
            </div>
            <h1 class="post__title"><%= post.title %></h1>
            <% if (post.image) { %><img class="post__cover" src="<%= post.image %>" alt="<%= post.title %>" /><% } %>
            <div class="prose"><%- bodyHtml %></div>

            <div class="post__cta">
              <h2>Want leads like the ones we describe?</h2>
              <a class="btn btn--gold" href="/#get-leads">
                Book a call <%- include('../partials/icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
