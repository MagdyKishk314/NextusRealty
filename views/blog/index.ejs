<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main" class="page">
    <section class="section">
      <div class="container">
        <div class="section-head section-head--left">
          <p class="eyebrow">The Nextus blog</p>
          <h1 class="section-title">Notes on leads that actually close</h1>
          <p class="section-subhead">How we source, confirm, and deliver exclusive real estate leads.</p>
        </div>

        <div class="blog-layout">
          <%- include('../partials/blog-sidebar', { categories: categories, currentCategory: currentCategory }) %>

          <div class="blog-main">
            <% if (currentCategory) { %>
              <p class="blog-filter">Showing <strong><%= currentCategory %></strong> &middot; <a class="link-gold" href="/blog">Clear filter</a></p>
            <% } %>
            <% if (!posts.length) { %>
              <p class="muted">No posts<%= currentCategory ? ' in this category' : '' %> yet. Check back soon.</p>
            <% } else { %>
              <div class="post-list">
                <% posts.forEach(function (post) { %>
                  <article class="post-card">
                    <% if (post.image) { %>
                      <a class="post-card__image" href="/blog/<%= post.slug %>"><img src="<%= post.image %>" alt="<%= post.title %>" loading="lazy" /></a>
                    <% } %>
                    <div class="post-card__meta">
                      <% if (post.category) { %><span class="post-card__cat"><%= post.category %></span><% } %>
                      <time class="post-card__date"><%= formatDate(post.published_at) %></time>
                    </div>
                    <h2 class="post-card__title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
                    <p class="post-card__excerpt"><%= post.excerpt %></p>
                    <a class="link-gold" href="/blog/<%= post.slug %>">Read more →</a>
                  </article>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
