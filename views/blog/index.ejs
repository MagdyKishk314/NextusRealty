<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="page">
    <section class="section">
      <div class="container">
        <div class="section-head section-head--left">
          <p class="eyebrow">The Nextus blog</p>
          <h1 class="section-title">Notes on leads that actually close</h1>
          <p class="section-subhead">How we source, confirm, and deliver exclusive real estate leads.</p>
        </div>

        <% if (!posts.length) { %>
          <p class="muted">No posts yet. Check back soon.</p>
        <% } else { %>
          <div class="post-list">
            <% posts.forEach(function (post) { %>
              <article class="post-card">
                <time class="post-card__date"><%= formatDate(post.published_at) %></time>
                <h2 class="post-card__title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
                <p class="post-card__excerpt"><%= post.excerpt %></p>
                <a class="link-gold" href="/blog/<%= post.slug %>">Read more →</a>
              </article>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
