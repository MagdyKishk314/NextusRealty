<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="page">
    <!-- Intro + the three services -->
    <section class="section section--muted">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--center"><span class="dot"></span><%= servicesIntro.eyebrow %></p>
          <h1 class="section-title"><%= servicesIntro.title %></h1>
          <p class="section-subhead"><%= servicesIntro.subhead %></p>
        </div>

        <div class="services">
          <% services.forEach(function (s, i) { %>
            <article class="service<%= i % 2 ? ' service--flip' : '' %>" id="<%= s.id %>">
              <figure class="service__media" data-reveal="<%= i % 2 ? 'right' : 'left' %>">
                <img class="service__img" src="<%= s.image %>" alt="<%= s.imageAlt %>" loading="lazy" />
                <span class="service__badge"><%- include('partials/icon', { name: s.icon, cls: 'icon' }) %></span>
                <div class="service__overlay">
                  <span class="service__overlay-label">Typical</span>
                  <ul class="service__tags">
                    <% s.examples.forEach(function (ex) { %>
                      <li class="service__tag"><%= ex %></li>
                    <% }); %>
                  </ul>
                </div>
              </figure>

              <div class="service__content" data-reveal="<%= i % 2 ? 'left' : 'right' %>">
                <p class="eyebrow"><%= s.kicker %></p>
                <h2 class="service__title"><%= s.title %></h2>
                <p class="service__tagline"><%= s.tagline %></p>
                <p class="service__body"><%= s.body %></p>
                <ul class="checklist service__list">
                  <% s.includes.forEach(function (inc) { %>
                    <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span><%= inc %></li>
                  <% }); %>
                </ul>
                <a class="link-gold service__cta" href="/#get-leads">
                  <%= s.ctaLabel %> <%- include('partials/icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
                </a>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="section section--dark">
      <div class="container services-cta" data-reveal>
        <p class="eyebrow eyebrow--center"><span class="dot"></span><%= servicesOutro.eyebrow %></p>
        <h2 class="section-title section-title--light"><%= servicesOutro.title %></h2>
        <p class="section-subhead section-subhead--light"><%= servicesOutro.subhead %></p>
        <a class="btn btn--gold btn--lg" href="<%= servicesOutro.ctaHref %>">
          <%= servicesOutro.ctaLabel %> <%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %>
        </a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
