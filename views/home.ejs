<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="container hero__inner">
        <p class="eyebrow eyebrow--center"><span class="dot"></span><%= home.hero.eyebrow %></p>
        <h1 class="hero__title">
          <%= home.hero.titleLead %> <span class="accent"><%= home.hero.titleAccent %></span> <%= home.hero.titleTail %>
        </h1>
        <p class="hero__tagline"><%= home.hero.tagline %></p>
        <p class="hero__subhead"><%= home.hero.subhead %></p>

        <div class="hero__cta">
          <a class="btn btn--gold btn--lg" href="#get-leads">
            Request your first leads <%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %>
          </a>
          <a class="btn btn--outline btn--lg" href="#comparison">See the difference</a>
        </div>

        <ul class="trust-list">
          <% home.hero.trustPoints.forEach(function (tp) { %>
            <li><%- include('partials/icon', { name: tp.icon, cls: 'icon icon--sm accent-fg' }) %><%= tp.label %></li>
          <% }); %>
        </ul>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats-section">
      <div class="container stats">
        <% home.stats.forEach(function (s) { %>
          <div class="stat">
            <div class="stat__value"><%= s.value %></div>
            <div class="stat__label"><%= s.label %></div>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Problem -->
    <section class="section section--muted">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow eyebrow--center"><%= home.problem.eyebrow %></p>
          <h2 class="section-title"><%= home.problem.title %></h2>
          <p class="section-subhead"><%= home.problem.subhead %></p>
        </div>
        <div class="compare-cards">
          <div class="card">
            <h3 class="card__kicker"><%= home.problem.typical.heading %></h3>
            <ul class="checklist">
              <% home.problem.typical.items.forEach(function (item) { %>
                <li><span class="mark mark--cross"><%- include('partials/icon', { name: 'cross', cls: 'icon icon--xs' }) %></span><%= item %></li>
              <% }); %>
            </ul>
          </div>
          <div class="card card--dark">
            <h3 class="card__kicker accent"><%= home.problem.nextus.heading %></h3>
            <ul class="checklist">
              <% home.problem.nextus.items.forEach(function (item) { %>
                <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span><%= item %></li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow eyebrow--center">How it works</p>
          <h2 class="section-title">Three steps between you and a signed contract</h2>
          <p class="section-subhead">No dashboards to babysit, no credits to burn. Quality control is our job. Closing is yours.</p>
        </div>
        <div class="steps">
          <% home.steps.forEach(function (st) { %>
            <div class="step">
              <div class="step__icon"><%- include('partials/icon', { name: st.icon, cls: 'icon' }) %></div>
              <div class="step__head"><span class="step__num"><%= st.step %></span><h3 class="step__title"><%= st.title %></h3></div>
              <p class="step__body"><%= st.body %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Why Nextus -->
    <section id="why-nextus" class="section section--dark">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow eyebrow--center"><%= home.features.eyebrow %></p>
          <h2 class="section-title section-title--light"><%= home.features.title %></h2>
          <p class="section-subhead section-subhead--light"><%= home.features.subhead %></p>
        </div>
        <div class="features">
          <% home.features.items.forEach(function (f) { %>
            <div class="feature">
              <div class="feature__icon"><%- include('partials/icon', { name: f.icon, cls: 'icon icon--sm' }) %></div>
              <h3 class="feature__title"><%= f.title %></h3>
              <p class="feature__body"><%= f.body %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section id="comparison" class="section section--muted">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow eyebrow--center"><%= home.comparison.eyebrow %></p>
          <h2 class="section-title"><%= home.comparison.title %></h2>
          <p class="section-subhead"><%= home.comparison.subhead %></p>
        </div>
        <div class="compare">
          <div class="compare__row compare__row--head">
            <div class="compare__cell compare__cell--label">The lead itself</div>
            <div class="compare__cell">Typical vendor</div>
            <div class="compare__cell compare__cell--nextus">Nextus</div>
          </div>
          <% home.comparison.rows.forEach(function (row) { %>
            <div class="compare__row<%= row.highlight ? ' is-highlight' : '' %>">
              <div class="compare__cell compare__cell--label"><%= row.label %></div>
              <div class="compare__cell">
                <% if (typeof row.typical === 'boolean') { %>
                  <span class="pill <%= row.typical ? 'pill--yes' : 'pill--no' %>"><%- include('partials/icon', { name: row.typical ? 'check' : 'cross', cls: 'icon icon--xs' }) %></span>
                <% } else { %><%= row.typical %><% } %>
              </div>
              <div class="compare__cell compare__cell--nextus">
                <% if (typeof row.nextus === 'boolean') { %>
                  <span class="pill <%= row.nextus ? 'pill--yes' : 'pill--no' %>"><%- include('partials/icon', { name: row.nextus ? 'check' : 'cross', cls: 'icon icon--xs' }) %></span>
                <% } else { %><%= row.nextus %><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Lead form -->
    <section id="get-leads" class="section section--dark lead">
      <div class="container lead__grid">
        <div class="lead__pitch">
          <p class="eyebrow">Get started</p>
          <h2 class="section-title section-title--light">Request your first batch of exclusive leads</h2>
          <p class="section-subhead section-subhead--light">
            Tell us your market and we'll put together a sample of what a confirmed
            lead looks like. No contracts, no credits, just leads that close.
          </p>
          <ul class="lead__points">
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>A dedicated specialist for your market</li>
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>First sample delivered within days</li>
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>Replace any lead that doesn't measure up</li>
          </ul>
          <p class="lead__privacy"><%- include('partials/icon', { name: 'shield', cls: 'icon icon--sm accent-fg' }) %> Your details stay private. We never resell your information, same as our leads.</p>
        </div>

        <div class="lead__card">
          <% if (submitted) { %>
            <div class="form-success" data-lead-success>
              <span class="form-success__icon"><%- include('partials/icon', { name: 'check', cls: 'icon' }) %></span>
              <h3>You're on the list</h3>
              <p>A market specialist will reach out shortly to line up your first sample of exclusive leads.</p>
              <a class="link-gold" href="#get-leads">Submit another request</a>
            </div>
          <% } %>
          <form class="lead-form<%= submitted ? ' is-hidden' : '' %>" action="/leads" method="post" data-lead-form novalidate>
            <div class="field-row">
              <label class="field"><span>Full name</span>
                <input type="text" name="name" autocomplete="name" placeholder="Jordan Ellis" required value="<%= (formValues && formValues.name) || '' %>" />
              </label>
              <label class="field"><span>Work email</span>
                <input type="email" name="email" autocomplete="email" placeholder="you@brokerage.com" required value="<%= (formValues && formValues.email) || '' %>" />
              </label>
            </div>
            <div class="field-row">
              <label class="field"><span>Phone</span>
                <input type="tel" name="phone" autocomplete="tel" placeholder="(555) 123-4567" value="<%= (formValues && formValues.phone) || '' %>" />
              </label>
              <label class="field"><span>Market / city</span>
                <input type="text" name="city" placeholder="Austin, TX" required value="<%= (formValues && formValues.city) || '' %>" />
              </label>
            </div>
            <label class="field"><span>Lead type</span>
              <select name="market" required>
                <option value="" disabled <%= (!formValues || !formValues.market) ? 'selected' : '' %>>Select a lead type</option>
                <% home.leadForm.markets.forEach(function (m) { %>
                  <option value="<%= m %>" <%= (formValues && formValues.market === m) ? 'selected' : '' %>><%= m %></option>
                <% }); %>
              </select>
            </label>
            <label class="field"><span>Monthly volume</span>
              <select name="volume" required>
                <option value="" disabled <%= (!formValues || !formValues.volume) ? 'selected' : '' %>>How many leads do you want?</option>
                <% home.leadForm.volumes.forEach(function (v) { %>
                  <option value="<%= v %>" <%= (formValues && formValues.volume === v) ? 'selected' : '' %>><%= v %></option>
                <% }); %>
              </select>
            </label>

            <p class="form-error<%= formError ? '' : ' is-hidden' %>" data-lead-error><%= formError || '' %></p>

            <button type="submit" class="btn btn--dark btn--block" data-lead-submit>
              <span>Request my leads</span> <%- include('partials/icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
            </button>
            <p class="form-fineprint">By submitting, you agree to be contacted about Nextus Realty lead services.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section section--muted">
      <div class="container faq">
        <div class="faq__intro">
          <p class="eyebrow">Questions</p>
          <h2 class="section-title">Everything you'd want to know first</h2>
          <p class="section-subhead">Still unsure? Request a sample. The quality answers most questions faster than we can.</p>
        </div>
        <div class="faq__list">
          <% faqs.forEach(function (faq, i) { %>
            <div class="faq__item<%= i === 0 ? ' is-open' : '' %>" data-faq-item>
              <button type="button" class="faq__q" data-faq-toggle aria-expanded="<%= i === 0 ? 'true' : 'false' %>">
                <span><%= faq.q %></span>
                <span class="faq__toggle"><span class="faq__plus"><%- include('partials/icon', { name: 'plus', cls: 'icon icon--sm' }) %></span><span class="faq__minus"><%- include('partials/icon', { name: 'minus', cls: 'icon icon--sm' }) %></span></span>
              </button>
              <div class="faq__a"><p><%= faq.a %></p></div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
