<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="top">
    <!-- ============================================================
         Authority journey: Claim (hero) → Proof (stats) → Pillars
         (why Nextus) → Method (how it works) → Evidence (comparison)
         → Objections (FAQ) → The ask (lead form).
         ============================================================ -->

    <!-- Hero: the claim -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true">
        <div class="hero__photo"></div>
        <video class="hero__video" autoplay muted loop playsinline preload="auto" poster="/img/hero.webp">
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero__tint"></div>
        <span class="hero__grid"></span>
      </div>

      <div class="container hero__inner">
        <p class="eyebrow eyebrow--center" data-hero-el><span class="dot"></span><%= home.hero.eyebrow %></p>
        <h1 class="hero__title">
          <%= home.hero.titleLead %> <span class="accent"><%= home.hero.titleAccent %></span> <%= home.hero.titleTail %>
        </h1>
        <p class="hero__tagline" data-hero-el><%= home.hero.tagline %></p>
        <p class="hero__subhead" data-hero-el><%= home.hero.subhead %></p>

        <div class="hero__cta" data-hero-el>
          <a class="btn btn--gold btn--lg" href="#get-leads">
            Request your first leads <%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %>
          </a>
          <a class="btn btn--outline btn--lg" href="#comparison">See the difference</a>
        </div>

        <ul class="trust-list" data-hero-el>
          <% home.hero.trustPoints.forEach(function (tp) { %>
            <li><%- include('partials/icon', { name: tp.icon, cls: 'icon icon--sm accent-fg' }) %><%= tp.label %></li>
          <% }); %>
        </ul>
      </div>

      <a class="hero__scroll" href="#stats" data-hero-el aria-label="Scroll to see more">
        <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
        <span class="hero__scroll-label">Scroll</span>
      </a>
    </section>

    <!-- Stats: immediate proof -->
    <section id="stats" class="stats-section">
      <div class="container stats">
        <% home.stats.forEach(function (s) { %>
          <div class="stat" data-reveal>
            <div class="stat__value" data-count><%= s.value %></div>
            <div class="stat__label"><%= s.label %></div>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Why Nextus: the authority pillars -->
    <section id="why-nextus" class="section section--dark">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--center"><%= home.features.eyebrow %></p>
          <h2 class="section-title section-title--light"><%= home.features.title %></h2>
          <p class="section-subhead section-subhead--light"><%= home.features.subhead %></p>
        </div>
        <div class="features">
          <% home.features.items.forEach(function (f) { %>
            <div class="feature" data-reveal>
              <div class="feature__icon"><%- include('partials/icon', { name: f.icon, cls: 'icon icon--sm' }) %></div>
              <h3 class="feature__title"><%= f.title %></h3>
              <p class="feature__body"><%= f.body %></p>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- How it works: the method -->
    <section id="how-it-works" class="section section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-dots deco--dot-tr"></span>
        <span class="deco-orb deco--bl"></span>
      </div>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--center">How it works</p>
          <h2 class="section-title">Three steps between you and a signed contract</h2>
          <p class="section-subhead">Quality control is our job. Closing is yours.</p>
        </div>
        <div class="steps">
          <% home.steps.forEach(function (st) { %>
            <div class="step" data-reveal>
              <div class="step__icon"><%- include('partials/icon', { name: st.icon, cls: 'icon' }) %></div>
              <div class="step__head"><span class="step__num"><%= st.step %></span><h3 class="step__title"><%= st.title %></h3></div>
              <p class="step__body"><%= st.body %></p>
            </div>
          <% }); %>
        </div>
        <p class="steps__cta" data-reveal>
          <a class="link-gold" href="/services">Explore our real estate lead types <%- include('partials/icon', { name: 'arrow', cls: 'icon icon--sm' }) %></a>
        </p>
      </div>
    </section>

    <!-- The confirmation call: motivation + human verification -->
    <section id="confirmation" class="section section--muted section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-orb deco--lg deco--tr"></span>
        <span class="deco-ring deco--bl"></span>
      </div>
      <div class="container confirm__grid">
        <div class="confirm__pitch">
          <p class="eyebrow" data-reveal="left"><%= home.confirmation.eyebrow %></p>
          <h2 class="section-title" data-reveal="left"><%= home.confirmation.title %></h2>
          <% home.confirmation.paragraphs.forEach(function (p) { %>
            <p class="section-subhead" data-reveal="left"><%= p %></p>
          <% }); %>
          <ul class="checklist confirm__checks" data-reveal="left">
            <% home.confirmation.checks.forEach(function (c) { %>
              <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span><%= c %></li>
            <% }); %>
          </ul>
        </div>

        <aside class="confirm__card" data-reveal="right">
          <div class="confirm__card-top">
            <span class="confirm__card-label"><%= home.confirmation.card.label %></span>
            <span class="confirm__badge"><%- include('partials/icon', { name: 'shield', cls: 'icon icon--xs' }) %> Confirmed</span>
          </div>
          <p class="confirm__card-who"><%- include('partials/icon', { name: 'phone', cls: 'icon icon--sm accent-fg' }) %> <%= home.confirmation.card.manager %></p>
          <ul class="confirm__card-list">
            <% home.confirmation.card.items.forEach(function (it) { %>
              <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span><%= it %></li>
            <% }); %>
          </ul>
          <div class="confirm__card-foot"><%= home.confirmation.card.status %></div>
        </aside>
      </div>
    </section>

    <!-- About the team: the authority behind the standard -->
    <section id="about" class="section section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-ring deco--lg deco--tl"></span>
        <span class="deco-dots deco--dot-br"></span>
      </div>
      <div class="container founder">
        <div class="founder__media" data-reveal="left">
          <figure class="founder__photo">
            <img src="<%= home.founder.photo %>" alt="<%= home.founder.name %>, founder of Nextus Realty" loading="lazy" />
          </figure>
          <div class="founder__id">
            <h3 class="founder__name"><%= home.founder.name %></h3>
            <p class="founder__role"><%= home.founder.role %></p>
          </div>
        </div>

        <div class="founder__pitch">
          <p class="eyebrow" data-reveal><%= home.founder.eyebrow %></p>
          <h2 class="section-title" data-reveal><%- home.founder.title %></h2>
          <% home.founder.paragraphs.forEach(function (p) { %>
            <p class="section-subhead" data-reveal><%= p %></p>
          <% }); %>
          <ul class="checklist founder__creds" data-reveal>
            <% home.founder.credentials.forEach(function (c) { %>
              <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span><%= c %></li>
            <% }); %>
          </ul>
          <div class="founder__book" data-reveal>
            <img class="founder__book-cover" src="<%= home.founder.book.cover %>" alt="Cover of <%= home.founder.book.title %>" loading="lazy" />
            <p class="founder__book-text">
              <strong><%= home.founder.book.title %></strong>
              <span><%= home.founder.book.blurb %></span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison: the evidence -->
    <section id="comparison" class="section section--muted section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-orb deco--tl"></span>
        <span class="deco-ring deco--br"></span>
      </div>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--center"><%= home.comparison.eyebrow %></p>
          <h2 class="section-title"><%- home.comparison.title %></h2>
          <p class="section-subhead"><%= home.comparison.subhead %></p>
        </div>
        <div class="compare" data-reveal-rows>
          <div class="compare__row compare__row--head">
            <div class="compare__cell compare__cell--label">The lead itself</div>
            <div class="compare__cell">Others</div>
            <div class="compare__cell compare__cell--nextus">Nextus</div>
          </div>
          <% home.comparison.rows.forEach(function (row) { %>
            <div class="compare__row<%= row.highlight ? ' is-highlight' : '' %>">
              <div class="compare__cell compare__cell--label"><%= row.label %></div>
              <div class="compare__cell">
                <% if (typeof row.typical === 'boolean') { %>
                  <span class="pill <%= row.typical ? 'pill--yes' : 'pill--no' %>"><%- include('partials/icon', { name: row.typical ? 'check' : 'cross', cls: 'icon icon--xs' }) %></span>
                <% } else if (row.typicalTip) { %>
                  <span class="has-tip" tabindex="0"><%= row.typical %><%- include('partials/icon', { name: 'info', cls: 'icon icon--xs has-tip__icon' }) %><span class="tip" role="tooltip"><%= row.typicalTip %></span></span>
                <% } else { %><%= row.typical %><% } %>
              </div>
              <div class="compare__cell compare__cell--nextus">
                <% if (typeof row.nextus === 'boolean') { %>
                  <span class="pill <%= row.nextus ? 'pill--yes' : 'pill--no' %>"><%- include('partials/icon', { name: row.nextus ? 'check' : 'cross', cls: 'icon icon--xs' }) %></span>
                <% } else if (row.nextusTip) { %>
                  <span class="has-tip" tabindex="0"><%= row.nextus %><%- include('partials/icon', { name: 'info', cls: 'icon icon--xs has-tip__icon' }) %><span class="tip" role="tooltip"><%= row.nextusTip %></span></span>
                <% } else { %><%= row.nextus %><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- FAQ: objection handling before the ask -->
    <section id="faq" class="section section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-dots deco--dot-tr"></span>
        <span class="deco-orb deco--sm deco--bl"></span>
      </div>
      <div class="container faq">
        <div class="faq__intro" data-reveal>
          <p class="eyebrow">Questions</p>
          <h2 class="section-title">Everything you'd want to know first</h2>
          <p class="section-subhead">Still unsure? Request a sample. The quality answers most questions faster than we can.</p>
        </div>
        <div class="faq__list">
          <% faqs.forEach(function (faq, i) { %>
            <div class="faq__item<%= i === 0 ? ' is-open' : '' %>" data-faq-item data-reveal>
              <button type="button" class="faq__q" data-faq-toggle aria-expanded="<%= i === 0 ? 'true' : 'false' %>">
                <span><%= faq.q %></span>
                <span class="faq__toggle"><span class="faq__plus"><%- include('partials/icon', { name: 'plus', cls: 'icon icon--sm' }) %></span><span class="faq__minus"><%- include('partials/icon', { name: 'minus', cls: 'icon icon--sm' }) %></span></span>
              </button>
              <div class="faq__a"><p><%= faq.a %></p></div>
            </div>
          <% }); %>
        </div>
        <div class="faq__cta" data-reveal>
          <a class="btn btn--dark btn--lg" href="/faq">
            Visit our FAQ page <%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %>
          </a>
        </div>
      </div>
    </section>

    <!-- Latest from the blog -->
    <% if (typeof posts !== 'undefined' && posts && posts.length) { %>
    <section id="blog-latest" class="section section--muted section--decor">
      <div class="section-decor" aria-hidden="true">
        <span class="deco-ring deco--tr"></span>
        <span class="deco-orb deco--sm deco--bl"></span>
      </div>
      <div class="container">
        <div class="blog-head" data-reveal>
          <div>
            <p class="eyebrow">From the blog</p>
            <h2 class="section-title">Notes on leads that close</h2>
          </div>
          <a class="btn btn--dark" href="/blog">
            View all posts <%- include('partials/icon', { name: 'arrow', cls: 'icon icon--sm' }) %>
          </a>
        </div>

        <div class="blog-slider" data-blog-slider>
          <div class="blog-slider__track" data-blog-track>
            <% posts.forEach(function (post) { %>
              <article class="post-card">
                <% if (post.image) { %>
                  <a class="post-card__image" href="/blog/<%= post.slug %>"><img src="<%= post.image %>" alt="<%= post.title %>" loading="lazy" /></a>
                <% } %>
                <div class="post-card__meta">
                  <% if (post.category) { %><span class="post-card__cat"><%= post.category %></span><% } %>
                  <time class="post-card__date"><%= formatDate(post.published_at) %></time>
                </div>
                <h3 class="post-card__title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
                <p class="post-card__excerpt"><%= post.excerpt %></p>
                <a class="link-gold" href="/blog/<%= post.slug %>">Read more &rarr;</a>
              </article>
            <% }); %>
          </div>
          <div class="blog-slider__nav">
            <button type="button" class="blog-slider__btn" data-blog-prev aria-label="Previous posts"><%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %></button>
            <button type="button" class="blog-slider__btn" data-blog-next aria-label="Next posts"><%- include('partials/icon', { name: 'arrow', cls: 'icon' }) %></button>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <!-- Lead form: the ask -->
    <section id="get-leads" class="section section--dark lead">
      <div class="container lead__grid">
        <div class="lead__pitch" data-reveal="left">
          <p class="eyebrow">Get started</p>
          <h2 class="section-title section-title--light">Book a call and get your first leads</h2>
          <p class="section-subhead section-subhead--light">
            Grab a 30-minute slot and we'll walk you through exactly what a
            confirmed lead looks like in your market. No contracts, just leads
            that close.
          </p>
          <ul class="lead__points">
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>A dedicated specialist for your market</li>
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>First sample delivered within days</li>
            <li><span class="mark mark--check"><%- include('partials/icon', { name: 'check', cls: 'icon icon--xs' }) %></span>Replace any lead that doesn't measure up</li>
          </ul>
          <p class="lead__privacy"><%- include('partials/icon', { name: 'shield', cls: 'icon icon--sm accent-fg' }) %> No pressure and no contracts, just a quick conversation about your market.</p>
        </div>

        <div class="lead__calendly" data-reveal="right">
          <!-- Calendly inline widget begin -->
          <div class="calendly-inline-widget" data-url="https://calendly.com/magdy-nextus/30min" style="min-width:320px;height:700px;"></div>
          <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
          <!-- Calendly inline widget end -->
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/bundle.js" defer></script>
</body>
</html>
