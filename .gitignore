# dependencies
/node_modules

# build output
/dist
# NOTE: public/js/bundle.js is committed on purpose — Vercel's native-Express
# setup serves committed files in public/ via its CDN but does NOT serve the
# build-generated ones, so the client bundle must be checked in. Rebuild it
# (`npm run build:client`) and commit after changing anything in src/client/.

# uploaded post images (user content, not source)
/public/uploads/*
!/public/uploads/.gitkeep

# database (runtime data)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# env
.env
.env.local

# vercel
.vercel

# misc
.DS_Store
*.log
npm-debug.log*

# stale Next.js build output (project no longer uses Next.js)
/.next

# Claude Code / agent tooling (not part of the project)
/.agents
/.claude
skills-lock.json
