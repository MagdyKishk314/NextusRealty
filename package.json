{
  "name": "nextus-realty",
  "version": "1.0.0",
  "private": true,
  "description": "Nextus Realty - classic MVC monolith (TypeScript + Express + EJS + node:sqlite)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --minify --sourcemap --target=es2018 --outfile=public/js/bundle.js && esbuild src/client/main-lite.ts --bundle --minify --sourcemap --target=es2018 --outfile=public/js/bundle-lite.js",
    "build:css": "esbuild public/css/styles.css --minify --outfile=public/css/styles.min.css --allow-overwrite",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:css && npm run build:server",
    "watch:client": "esbuild src/client/main.ts --bundle --sourcemap --target=es2018 --outfile=public/js/bundle.js --watch",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server.js",
    "seed": "npm run build:server && node dist/db/seed-cli.js",
    "og": "node scripts/generate-og.mjs",
    "optimize:img": "node scripts/optimize-images.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "esbuild": "^0.24.2",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
